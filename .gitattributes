# Normalize line endings: JS/CSS/HTML/MD/SH/JSON/PY → LF in repo, CRLF on checkout
* text=auto
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.example text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.svg text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.db binary
*.node binary
