node_modules/
.venv/
logs/
screenshots/
runtime-data/
data/*.db*
# 装机脚本写的版本戳,跟着机器不跟着仓库
data/version.json
*.log
.sisyphus/
.claude/

# Local env / secrets
.env
.env.*
!.env.example
**/.env
**/.env.*

# Python junk
**/__pycache__/
*.py[cod]
*.egg-info/

# Task automation scripts (keep only templates/examples + shared helpers)
tasks/**
!tasks/template.js
!tasks/example.js
!tasks/template.py
!tasks/example.py
!tasks/lib/
!tasks/lib/**
# The tasks/lib/** re-include above out-ranks the generic __pycache__ rule,
# so bytecode under it has to be excluded again explicitly.
tasks/lib/**/__pycache__/

