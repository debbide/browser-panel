{
  "version": "1.0",
  "meta": {
    "name": "real-iframe-checkout",
    "created_at": "2026-05-05T00:00:00.000Z",
    "start_url": "https://example.com/checkout"
  },
  "steps": [
    {
      "id": "f1",
      "type": "input",
      "selector": {
        "primary": "css",
        "value": "#card-number",
        "fallbacks": []
      },
      "value": "4242424242424242",
      "frame": {
        "in_iframe": true,
        "selector": "iframe#payment-frame"
      }
    },
    {
      "id": "f2",
      "type": "input",
      "selector": {
        "primary": "css",
        "value": "#card-exp",
        "fallbacks": []
      },
      "value": "12/30",
      "frame": {
        "in_iframe": true,
        "name": "payment-iframe"
      }
    },
    {
      "id": "f3",
      "type": "click",
      "selector": {
        "primary": "css",
        "value": "#pay-now",
        "fallbacks": []
      }
    },
    {
      "id": "f4",
      "type": "wait",
      "wait_for": "ready_state",
      "timeout_ms": 8000
    }
  ]
}
