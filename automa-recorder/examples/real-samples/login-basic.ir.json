{
  "version": "1.0",
  "meta": {
    "name": "real-login-basic",
    "created_at": "2026-05-05T00:00:00.000Z",
    "start_url": "https://example.com/login"
  },
  "steps": [
    {
      "id": "r1",
      "type": "input",
      "selector": {
        "primary": "css",
        "value": "#email",
        "fallbacks": [
          { "type": "testid", "value": "email-input" }
        ]
      },
      "value": "demo@example.com"
    },
    {
      "id": "r2",
      "type": "input",
      "selector": {
        "primary": "css",
        "value": "#password",
        "fallbacks": []
      },
      "value": "{{SECRET}}"
    },
    {
      "id": "r3",
      "type": "click",
      "selector": {
        "primary": "css",
        "value": "button[type='submit']",
        "fallbacks": []
      }
    },
    {
      "id": "r4",
      "type": "wait",
      "wait_for": "url_change",
      "page_url": "https://example.com/login",
      "timeout_ms": 12000
    },
    {
      "id": "r5",
      "type": "assert_url_contains",
      "value": "dashboard"
    }
  ]
}
