# Copy to /opt/browser-panel/.env.panel and edit.
# systemd: EnvironmentFile=-/opt/browser-panel/.env.panel

PORT=3210
# 面板有登录鉴权（首次打开走引导页设账号密码），但是纯 HTTP —— 密码和会话
# Cookie 在链路上是明文的。绑 0.0.0.0 就是把面板挂在公网上，而面板能写并执行
# 任务脚本、服务又是 root 跑的，所以强烈建议改成 127.0.0.1 走 SSH 隧道
# （ssh -L 3210:127.0.0.1:3210 root@服务器IP），或者前面挂 nginx + TLS。
# HOST=127.0.0.1
HOST=0.0.0.0

BROWSER_DISPLAY=:1.0
# Chrome/Chromium binary. amd64 Google Chrome:
# BROWSER_CHROME_PATH=/usr/bin/google-chrome-stable
# ARM / Ubuntu snap Chromium — use the real ELF, NOT /usr/bin/chromium-browser
# (wrapper dies under systemd: "not a snap cgroup for tag snap.chromium.chromium"):
BROWSER_CHROME_PATH=/snap/chromium/current/usr/lib/chromium-browser/chrome

# Linux user that runs the browser (create this user + home/browser-work on the host)
BROWSER_USER=browser
BROWSER_HOME=/home/browser
BROWSER_WORK_DIR=/home/browser/browser-work
BROWSER_XAUTHORITY=/home/browser/.Xauthority
BROWSER_USER_DATA_DIR=/home/browser/browser-work/persistent

# Task default proxy (optional). Prefer setting per-task in the panel.
# BROWSER_PROXY=socks5://127.0.0.1:1080

# If Node/npm need HTTP proxy for updates (same as your sing-box port if used):
# http_proxy=http://127.0.0.1:18999
# https_proxy=http://127.0.0.1:18999
